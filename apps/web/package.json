{
  "name": "@projektor/web",
  "version": "0.4.15",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/assert-sw.mjs",
    "type-check": "astro check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
