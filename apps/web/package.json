{
	"name": "@projektor/web",
	"version": "0.6.11",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"build": "astro build && node scripts/assert-sw.mjs && node scripts/gen-csp-headers.mjs",
		"type-check": "astro check",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test --grep-invert @long",
		"test:e2e:long": "playwright test --grep @long",
		"verify:sw": "node scripts/assert-sw.mjs"
	},
	"dependencies": {
		"@astrojs/preact": "^6.0.2",
		"@codemirror/commands": "^6.10.4",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.8",
		"@preact/signals": "^2.11.1",
		"@projektor/types": "workspace:*",
		"astro": "^7.2.1",
		"dompurify": "^3.4.13",
		"marked": "^18.0.9",
		"mermaid": "^11.16.1",
		"preact": "^10.29.8",
		"uplot": "^1.6.32",
		"workbox-window": "^7.4.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/preact": "^3.2.0",
		"@vite-pwa/astro": "^1.2.0",
		"@vitest/coverage-v8": "^4.1.10",
		"jsdom": "^30.0.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite-plugin-pwa": "1.3.0",
		"vitest": "^4.1.10"
	}
}
