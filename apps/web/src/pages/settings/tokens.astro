---
import Base from '../../layouts/Base.astro';
import TokenManager from '../../islands/TokenManager';
import ConnectorManager from '../../islands/ConnectorManager';

const workspaceSlug = import.meta.env.PUBLIC_WORKSPACE_SLUG as string | undefined;
---
<Base title="API Tokens — Projektor">
  <div class="page-container">
    <header style="margin-bottom: 1.5rem;">
      <h1 style="margin: 0 0 .25rem; font-size: 1.5rem; font-weight: 700; color: var(--text);">
        API Tokens
      </h1>
      <p style="margin: 0; font-size: .875rem; color: var(--text-muted);">
        Manage workspace API tokens for agents and scripts.
      </p>
    </header>
    <TokenManager client:load workspaceSlug={workspaceSlug} />

    <header style="margin: 2.5rem 0 1.5rem;">
      <h2 style="margin: 0 0 .25rem; font-size: 1.25rem; font-weight: 700; color: var(--text);">
        Connected applications
      </h2>
      <p style="margin: 0; font-size: .875rem; color: var(--text-muted);">
        Applications you have authorized to reach this workspace on your behalf. Yours only &mdash; other members manage their own.
      </p>
    </header>
    <ConnectorManager client:load workspaceSlug={workspaceSlug} />
  </div>
</Base>
