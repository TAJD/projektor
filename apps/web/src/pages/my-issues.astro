---
import Base from '../layouts/Base.astro';
import MyIssues from '../islands/MyIssues';

const workspaceSlug = import.meta.env.PUBLIC_WORKSPACE_SLUG as string | undefined;
---
<Base title="My Issues — Projektor">
  <div class="page-container">
    <header style="margin-bottom: 1.5rem;">
      <h1 style="margin: 0; font-size: 1.5rem; font-weight: 700; color: var(--text);">My Issues</h1>
    </header>
    <MyIssues client:load workspaceSlug={workspaceSlug} />
  </div>
</Base>
