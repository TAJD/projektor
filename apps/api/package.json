{
  "name": "@projektor/api",
  "version": "0.0.0-workspace",
  "private": true,
  "scripts": {
    "dev": "pnpm db:migrate:local && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply projektor --local",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "gen:catalog": "tsx scripts/gen-mcp-catalog.ts",
    "gen:workflow-spec": "tsx scripts/gen-workflow-spec.ts",
    "gen:playbooks": "tsx scripts/gen-playbooks.ts"
  },
  "dependencies": {
    "@projektor/db": "workspace:*",
    "@projektor/plugin-sdk": "workspace:*",
    "@projektor/types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "hono": "^4.13.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@cloudflare/workers-types": "^5.20260813.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  }
}
