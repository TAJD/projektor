{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // "node" is here because src/test/mcp-parity.node.test.ts imports node:fs/path and uses
    // import.meta.dirname. It resolved without being declared only because drizzle-orm 0.33
    // shipped a `/// <reference types="node" />` in sqlite-core/columns/blob.d.ts, which pulled
    // @types/node into the program as a side effect; 0.45 dropped that reference (PROJ-302).
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types", "node"]
  },
  "include": ["src"]
}
